{
    "name": "vscode-archery-game",
    "displayName": "Archery Master",
    "description": "A lightweight archery master game for VS Code",
    "version": "0.0.7",
    "license": "MIT",
    "publisher": "PrinceGarg",
    "icon": "media/icon.png",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "archery.start",
                "title": "Start Archery Master"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/vscode": "^1.80.0",
        "@types/node": "^18.0.0",
        "typescript": "^5.1.0"
    }
}